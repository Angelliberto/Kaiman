PORT=3000
# Orígenes permitidos (separados por coma). En producción incluye tu dominio de Vercel.
CLIENT_ORIGIN=http://localhost:5173,https://tu-proyecto.vercel.app
HOST_NAME=KAIMAN
HOST_TAGLINE=Turismo en Venezuela
LISTINGS_FILE=./listings.json
DESTINATIONS_FILE=./destinations.json
DESTINATION_IMAGES_DIR=../front/public/images
TOUR_DEPARTURES_FILE=./tour-departures.json

# Si el API está detrás de un proxy (Vercel, nginx), activa para rate-limit por IP real
# TRUST_PROXY=1

# Correo de destino de los formularios de contacto
CONTACT_TO=Kaimantravel@gmail.com

# SMTP (Gmail: usa una "Contraseña de aplicaciones", no la clave normal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=Kaimantravel@gmail.com
SMTP_PASS=tu-contraseña-de-aplicacion
SMTP_FROM=Kaimantravel@gmail.com

# Panel admin (/admin) — ambos obligatorios
ADMIN_PASSWORD=cambia-esta-clave
ADMIN_SECRET=cambia-este-secreto-largo
# Opcional: duración del token en ms (por defecto 12 horas)
# ADMIN_TOKEN_TTL_MS=43200000
